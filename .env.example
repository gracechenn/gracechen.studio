# Copy this file to .env.local and fill in real values (never commit .env.local).

# Stripe — use TEST-mode keys during development (dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_<your-test-secret-key>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<your-test-publishable-key>

# Public site URL — used for SEO metadataBase and Stripe success/cancel redirects.
# Local dev: http://localhost:3000  ·  Production: https://gracechen.studio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe webhook signing secret — for /api/stripe/webhook (inventory + refunds).
# Get it when you add the endpoint in the Stripe Dashboard (or `stripe listen`
# for local testing). Leave unset to disable the webhook gracefully.
STRIPE_WEBHOOK_SECRET=whsec_<your-webhook-signing-secret>

# Vercel KV / Upstash Redis — inventory + order snapshots. Leave unset to run
# with inventory disabled (prints unlimited, originals follow the catalog).
KV_REST_API_URL=https://<your-store>.upstash.io
KV_REST_API_TOKEN=<your-kv-rest-token>

# Admin inventory page (/admin/inventory), protected with HTTP Basic Auth.
# Leave ADMIN_PASSWORD unset to disable the admin routes (they 404). ADMIN_USER
# is optional and defaults to "admin".
ADMIN_USER=admin
ADMIN_PASSWORD=<choose-a-strong-password>
